{
  "name": "hamburgueseria",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build:shared": "npm run build -w @hamburgueseria/shared",
    "dev:api": "npm run build:shared && npm run start:dev -w api"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
